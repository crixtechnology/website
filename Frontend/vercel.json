{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "redirects": [
    { "source": "/programs", "destination": "/training-internship", "permanent": true },
    { "source": "/paid-internships", "destination": "/training-internship", "permanent": true },
    { "source": "/internships", "destination": "/training-internship", "permanent": true },
    { "source": "/courses", "destination": "/training-internship", "permanent": true },
    { "source": "/payment", "destination": "/training-internship", "permanent": true },
    { "source": "/ambassador", "destination": "/", "permanent": true },
    { "source": "/bca-internships", "destination": "/free-internships", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:page(training-internship|services|about|contact|careers|privacy-policy|terms-of-service|client-terms)", "destination": "/:page/index.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/free-internships",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
