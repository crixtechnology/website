# Cloudflare Pages only (Vercel ignores this file and uses vercel.json).
# Same headers as vercel.json. No _redirects is needed: with no 404.html,
# Pages serves index.html for every address, like vercel.json's rewrite.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive

/static/*
  Cache-Control: public, max-age=31536000, immutable
