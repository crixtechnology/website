// Prisma schema for the Crix Technology backend (migrated from MongoDB/Mongoose).
//
// Every model uses a cuid() string primary key — not an auto-increment int —
// specifically so `id` keeps behaving like Mongo's opaque ObjectId string
// end-to-end (the API serializer re-exposes it as `_id`; the Frontend does
// `_id === _id` comparisons and stores ids in component state/`<select>`
// values, so a numeric id could silently break those via type mismatch).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  student
}

model User {
  id                       String    @id @default(cuid())
  name                     String
  email                    String    @unique
  phone                    String    @default("")
  passwordHash             String?
  googleId                 String?   @unique
  role                     Role      @default(student)
  activeSessionId          String?
  activeSessionLastSeenAt  DateTime?
  // Shown to the student in "Refer & earn"; friends enter it at signup/checkout.
  // Created lazily (utils/referrals.js ensureReferralCode) and stored without
  // punctuation, e.g. CRIXK7P3QZ.
  referralCode             String?   @unique
  // The auto-generated starter password given to an account that signed up /
  // signed in with Google (so it also has a working email+password login),
  // AES-256-GCM encrypted (utils/passwordVault.js) so the owner can look it up
  // in their profile after an emailed OTP. Only ever holds a SYSTEM-generated
  // password: cleared the moment the user picks their own (change or reset),
  // and never written for a password the user chose — those exist only as the
  // bcrypt `passwordHash` and can't be shown to anyone.
  defaultPasswordEnc       String?   @db.Text
  // An email/password signup's welcome credit waits here until the student
  // proves the email is theirs with an emailed code (utils/wallet.js
  // holdSignupBonus / claimSignupBonus) — so made-up addresses can't farm it.
  signupBonusPending       Boolean   @default(false)
  // When the student confirmed at sign-up that they are 18 or older, or that a
  // parent/guardian has agreed to them using the site (users must be 16+).
  // Null only for accounts made before the checkbox existed.
  ageConfirmedAt           DateTime?
  // Set when an admin resets this account's password (Admin → Users) and hands
  // the owner a temporary one: the site then asks them to choose their own at
  // the next login. Cleared as soon as they change or reset it.
  mustChangePassword       Boolean   @default(false)
  // True for an account made straight from the login form (email + password
  // only): its name is a placeholder taken from the email until the owner
  // saves their real one in Profile. Nothing can be bought until then.
  profilePending           Boolean   @default(false)
  // Education, from Profile: optional, but needed before applying for a free
  // internship (utils/accounts.js educationMissing). semester is "1".."10" or
  // "graduated" (utils/accounts.js SEMESTERS).
  college                  String    @default("") @db.VarChar(150)
  course                   String    @default("") @db.VarChar(100)
  department               String    @default("") @db.VarChar(100)
  semester                 String    @default("") @db.VarChar(16)
  passingYear              Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  enrollments  Enrollment[]
  applications Application[]
  payments     Payment[]

  referralsMade Referral[]    @relation("Referrer")
  referredBy    Referral?     @relation("Referee")
  creditEntries CreditEntry[]
  emailOtps     EmailOtp[]
  paymentRequests PaymentRequest[]
  jobApplications JobApplication[]
  notifications   Notification[]

  @@map("users")
}

enum Tier {
  basic
  plus
  pro
}

enum CourseType {
  course
  internship
}

enum CourseStatus {
  open
  closed
}

// One-time email codes for the password flows (forgot password, and revealing
// the starter password in the profile). At most one live code per user per
// purpose — issuing a new one replaces the old. Only an HMAC of the code is
// stored, never the code itself, and a row is deleted as soon as it's used.
model EmailOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String   // "reset_password" | "view_password" | "verify_email" | "delete_account"
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, purpose])
  @@map("email_otps")
}

model Course {
  id              String       @id @default(cuid())
  type            CourseType   @default(course)
  title           String
  slug            String       @unique
  tag             String       @default("")
  // MySQL forbids a DEFAULT on TEXT columns — the app always passes `desc ||
  // ""` on create (routes/courses.js), so no DB-level default is needed.
  desc            String       @db.Text
  points          Json         @default("[]")
  // The richer course page (see Frontend CourseDetail). All optional lists the admin fills
  // in per course; an empty one simply isn't shown on the page.
  //   outcomes:      "What you'll learn" — short bullets
  //   audience:      "Who it's for" — short bullets
  //   prerequisites: "What you need before you start" — short bullets
  //   faqs:          [{ q, a }] — questions and answers
  outcomes        Json         @default("[]")
  audience        Json         @default("[]")
  prerequisites   Json         @default("[]")
  faqs            Json         @default("[]")
  durationDays    Int?
  // When the course/internship begins. Students can buy (and get their
  // receipt) before it, but its content — videos, live classes — stays locked
  // until this moment, and their access period (durationDays) counts from it
  // rather than from the purchase. Null = starts as soon as it's bought.
  startsAt        DateTime?
  status          CourseStatus @default(open)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tiers        CourseTier[]
  lectures     Lecture[]
  videos       Video[]
  enrollments  Enrollment[]
  applications Application[]
  payments     Payment[]
  paymentRequests PaymentRequest[]

  @@map("courses")
}

// One row per plan (basic / plus / pro) a course or internship offers. A tier
// row existing IS the tier being offered — an item with zero rows is
// apply-only / not purchasable. Replaces the old single Course.price and
// Course.discountPercent columns (migration 20260919_course_tiers copies each
// old price into a Basic row). `features` is an admin-written list of what
// that plan includes; it is descriptive only — course access is not gated by tier.
model CourseTier {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tier            Tier
  price           Float
  discountPercent Int      @default(0)
  features        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([courseId, tier])
  @@map("course_tiers")
}

model Lecture {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  title           String
  scheduledAt     DateTime
  scheduledEndAt  DateTime
  link            String
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courseId, scheduledAt])
  @@map("lectures")
}

model Video {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  title             String
  b2Key             String   @unique
  sourceDriveFileId String?
  dayNumber         Int
  durationSeconds   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([courseId, dayNumber])
  @@map("videos")
}

enum EnrollmentStatus {
  active
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  paymentId String?
  payment   Payment?         @relation(fields: [paymentId], references: [id])
  tier      Tier?
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    EnrollmentStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum ApplicationType {
  internship
  course
}

model Application {
  id        String          @id @default(cuid())
  type      ApplicationType
  refTitle  String
  name      String
  email     String
  phone     String
  college   String          @default("")
  track     String          @default("")
  tier      Tier?
  paymentId String?
  payment   Payment?        @relation("ApplicationCurrentPayment", fields: [paymentId], references: [id])
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  courseId  String?
  course    Course?         @relation(fields: [courseId], references: [id])
  contacted Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  paymentsFor Payment[] @relation("PaymentApplication")

  @@map("applications")
}

// An offer/discount code the admin creates in the admin panel and a student
// enters at checkout (courses and internships). See utils/coupons.js for how a
// code is checked and priced.
enum DiscountType {
  percent
  fixed
}

enum CouponScope {
  all
  course
  internship
  selected
}

model Coupon {
  id            String       @id @default(cuid())
  // Stored normalised (A-Z 0-9 only, upper case): people type these in any case
  // and with or without dashes.
  code          String       @unique
  description   String       @default("")
  discountType  DiscountType
  // Percent (1-90), or whole rupees off, depending on discountType.
  discountValue Int
  // For a percent code: never take off more than this many rupees.
  maxDiscount   Int?
  appliesTo     CouponScope  @default(all)
  // Only used when appliesTo is "selected": the ids of the courses/internships.
  courseIds     Json         @default("[]")
  startsAt      DateTime?
  expiresAt     DateTime?
  // Total redemptions allowed across everyone; null = unlimited.
  maxUses       Int?
  // How many times one student may redeem it.
  perUserLimit  Int          @default(1)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  payments Payment[]

  @@map("coupons")
}

enum PaymentStatus {
  created
  paid
  failed
}

model Payment {
  id                            String        @id @default(cuid())
  razorpayOrderId               String
  razorpayPaymentId             String?
  razorpaySignature             String?
  amount                        Int
  currency                      String        @default("INR")
  // Paise taken off this order by a referral discount / by referral credit the
  // buyer had earned. `amount` is already net of both.
  referralDiscount              Int           @default(0)
  creditApplied                 Int           @default(0)
  // The admin-created offer code (see Coupon) this order used, and the paise it
  // took off. `couponCode` is a snapshot, so the history survives the code being
  // edited or deleted. `amount` is already net of it.
  couponId                      String?
  coupon                        Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode                    String        @default("")
  couponDiscount                Int           @default(0)
  tier                          Tier?
  // Set only on a plan-upgrade payment: the plan the buyer held before
  // paying the difference to reach `tier`. Null for an ordinary purchase.
  fromTier                      Tier?
  status                        PaymentStatus @default(created)
  applicationId                 String?
  application                   Application?  @relation("PaymentApplication", fields: [applicationId], references: [id])
  userId                        String?
  user                          User?         @relation(fields: [userId], references: [id])
  courseId                      String?
  course                        Course?       @relation(fields: [courseId], references: [id])
  orderSnapshotBasePrice        Float?
  orderSnapshotDiscountPercent  Float?
  // --- flattened `receipt` subdocument (see the model comment in the old
  // Mongoose Payment.js) — reassembled into a nested `receipt: {...}` object
  // by src/utils/serialize.js so the API response shape is unchanged. ---
  receiptNumber                 String?       @unique
  receiptIssuedAt               DateTime?
  receiptBuyerName              String        @default("")
  receiptBuyerEmail             String        @default("")
  receiptBuyerPhone             String        @default("")
  receiptItemType                String?
  receiptItemTitle              String        @default("")
  receiptBasePrice              Float         @default(0)
  receiptDiscountPercent        Float         @default(0)
  receiptDiscountAmount         Float         @default(0)
  receiptTotalPaid              Float         @default(0)
  receiptPaymentMode            String        @default("Razorpay (Online)")
  // Set only on a payment made against an admin's PaymentRequest (see that
  // model) — such a payment has no Application, and is ordered, verified and
  // granted by routes/paymentRequests.js instead of the normal checkout.
  paymentRequestId              String?
  paymentRequest                PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  // Set only on an aptitude-test fee payment (see JobApplication) — ordered,
  // verified and granted by routes/careers.js, never by the normal checkout.
  jobApplicationId              String?
  jobApplication                JobApplication? @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  // When the buyer ticked "I agree to the Terms & Conditions" for this payment
  // (utils/terms.js). Null only on payments made before the checkbox existed.
  termsAcceptedAt               DateTime?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  applicationsUsingThis Application[] @relation("ApplicationCurrentPayment")
  enrollments           Enrollment[]

  @@map("payments")
}

enum PaymentRequestStatus {
  pending
  paid
  cancelled
}

// An admin asking one specific student to pay a set amount for one course or
// internship. Separate from the normal checkout (no plan pricing, offer codes,
// referral discounts or credit, and it works whether the course is open or
// closed): the student sees it on their dashboard, pays it, and gets access.
// Each pay attempt is its own Payment row (paymentRequestId) so the paid one
// carries a normal receipt; paidPaymentId points at that one.
model PaymentRequest {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The plan the access counts as, if any — descriptive, like everywhere else.
  tier          Tier?
  // Paise.
  amount        Int
  note          String               @default("")
  status        PaymentRequestStatus @default(pending)
  paidPaymentId String?
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  payments Payment[]

  @@index([userId, status])
  @@map("payment_requests")
}

enum ContactStatus {
  new
  read
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String        @default("")
  phone     String        @default("")
  company   String        @default("")
  interest  String        @default("")
  // MySQL forbids a DEFAULT on TEXT columns — the app always passes
  // `message || ""` on create (routes/contact.js), so no DB-level default.
  message   String        @db.Text
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contacts")
}

enum ServiceStatus {
  active
  inactive
}

model Service {
  id        String        @id @default(cuid())
  tag       String        @default("")
  title     String
  // MySQL forbids a DEFAULT on TEXT columns — the app always passes
  // `desc || ""` on create (routes/services.js), so no DB-level default.
  desc      String        @db.Text
  points    Json          @default("[]")
  order     Int           @default(0)
  status    ServiceStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("services")
}

// Named counter (one row per sequence). The receipt_CR / receipt_IN /
// receipt_AT rows number the course, internship and aptitude-test receipt
// series — see utils/receiptNumber.js, the only code that touches them:
// unique, consecutive, and race-safe.
model Counter {
  name String @id
  seq  Int    @default(0)

  @@map("counters")
}

enum ReferralStatus {
  pending
  rewarded
}

// One row per referred student (refereeId is unique — a student can only ever
// be referred once). Created when a code is applied; flips to rewarded, and the
// referrer is credited, when the referee's first course/internship payment lands.
// The discount % and reward are snapshotted at apply time so later changes to
// the admin settings never change what was promised.
model Referral {
  id                     String         @id @default(cuid())
  referrerId             String
  referrer               User           @relation("Referrer", fields: [referrerId], references: [id])
  refereeId              String         @unique
  referee                User           @relation("Referee", fields: [refereeId], references: [id])
  status                 ReferralStatus @default(pending)
  refereeDiscountPercent Int            @default(0)
  // Paise credited to the referrer when this is rewarded.
  rewardAmount           Int            @default(0)
  qualifyingPaymentId    String?
  createdAt              DateTime       @default(now())
  rewardedAt             DateTime?

  creditEntries CreditEntry[]

  @@index([referrerId])
  @@map("referrals")
}

enum CreditKind {
  referral_reward
  redeemed
  adjustment
  // Careers: the welcome credit every new student account gets, the aptitude-test
  // fee handed back as credit, and credit that lapsed unused (see utils/wallet.js).
  signup_bonus
  test_fee_credit
  expired
}

// Append-only ledger of a student's referral credit, in paise: + earned, - spent.
// Balance is the sum, so there is no counter to race on. The unique pairs make
// "reward this referral" and "redeem for this payment" idempotent when /verify
// and the Razorpay webhook both fire.
model CreditEntry {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  amount     Int
  kind       CreditKind
  referralId String?
  referral   Referral?  @relation(fields: [referralId], references: [id])
  paymentId  String?
  note       String     @default("")
  // Only on credit that lapses (signup bonus, test-fee credit): after this moment
  // whatever is left of it is taken back by an `expired` entry. Null = never expires.
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())

  @@unique([paymentId, kind])
  @@unique([referralId, kind])
  @@index([userId])
  @@map("credit_entries")
}

// Small key/value store for admin-editable settings (currently the referral rules).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// A question a visitor typed into the site's help bot that it had no answer for
// (routes/botQuestions.js). One row per distinct question, lower-cased, with
// emails / phone numbers / links already masked, plus a counter — so repeats show
// up as "asked 7 times" in the admin panel. No name, account or IP is stored.
model BotQuestion {
  id           String   @id @default(cuid())
  question     String   @unique @db.VarChar(191)
  timesAsked   Int      @default(1)
  // Set by an admin once the bot can answer it (or it's not worth answering);
  // asking it again reopens it.
  handled      Boolean  @default(false)
  firstAskedAt DateTime @default(now())
  lastAskedAt  DateTime @default(now())
  // An answer an admin taught the help agent for this question (Admin → Help
  // agent questions). The site's agent loads every answered row (GET
  // /bot/answers) and replies with it when a visitor asks something similar.
  answer       String?  @db.Text
  // Extra words that should also find this answer ("weekend saturday sunday").
  keywords     String   @default("") @db.VarChar(300)
  // Optional in-site page to link under the answer, e.g. "/programs".
  linkTo       String   @default("") @db.VarChar(120)
  linkLabel    String   @default("") @db.VarChar(60)
  // "" | "programs" | "it" | "both": show that team's phone card under the answer.
  dept         String   @default("") @db.VarChar(10)
  answeredAt   DateTime?

  @@index([handled, timesAsked])
  @@map("bot_questions")
}

// ====================== Careers & the aptitude test ======================
// A role on the public /careers page, with the settings of its aptitude test.
// Admin-managed (routes/adminCareers.js): add, edit, or close.
enum OpeningStatus {
  open
  closed
}

model JobOpening {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  summary          String        @db.Text
  // Which technical question bank this role's test draws from:
  // "web" | "fullstack" | "datascience" | "frontend" | "python" | "webfundamentals"
  // | "aiml" (utils/careers.js TECH_CATEGORIES).
  techCategory     String        @default("web")
  skills           Json          @default("[]")
  responsibilities Json          @default("[]")
  eligibility      Json          @default("[]")
  stipend          String        @default("")
  experience       String        @default("")
  duration         String        @default("")
  mode             String        @default("")
  status           OpeningStatus @default(open)
  order            Int           @default(0)
  // false = a free role: the aptitude test unlocks without the registration fee.
  feeRequired      Boolean       @default(true)
  // Who the role is listed for: "general" (the /careers page and the dashboard)
  // or "free" (only the unlinked /free-internships page, where a CV is required).
  audience         String        @default("general") @db.VarChar(16)
  // --- this role's test ---
  durationMinutes  Int           @default(45)
  // { quantitative, logical, verbal, technical }: how many questions of each.
  questionCounts   Json          @default("{}")
  marksPerQuestion Float         @default(1)
  // Taken off for each wrong answer (a positive number, e.g. 0.25).
  negativeMarks    Float         @default(0.25)
  cutoffScore      Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications JobApplication[]

  @@map("job_openings")
}

// The question bank. `category` is one of utils/careers.js CATEGORIES. The
// correct answer (correctIndex into options) never leaves the server.
model TestQuestion {
  id           String   @id @default(cuid())
  category     String   @db.VarChar(32)
  text         String   @db.Text
  options      Json
  correctIndex Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, active])
  @@map("test_questions")
}

enum JobApplicationStatus {
  payment_pending
  test_pending
  submitted
  shortlisted
  not_shortlisted
  interview_scheduled
  selected
  rejected
}

// One student applying for one role. Paying the test fee moves it from
// payment_pending to test_pending and unlocks exactly one TestAttempt.
model JobApplication {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingId     String
  opening       JobOpening           @relation(fields: [openingId], references: [id])
  status        JobApplicationStatus @default(payment_pending)
  // The Payment that paid the test fee.
  paymentId     String?
  paidAt        DateTime?
  interviewAt   DateTime?
  interviewLink String               @default("") @db.VarChar(500)
  adminNote     String               @default("") @db.VarChar(500)
  // When it reached a final status (selected / not shortlisted / rejected);
  // cleared if it is reopened. Webcam photos are deleted 6 months after this
  // (utils/proctorRetention.js).
  closedAt      DateTime?
  // When the candidate confirmed they are 18 or older — the aptitude test
  // (webcam monitoring) is for adults only. Set when paying the fee or, for an
  // older application, when starting the test.
  adultConfirmedAt DateTime?
  // The candidate's CV (a PDF), required for a "free" role before its test
  // unlocks. Stored like the webcam photos (utils/proctorStorage.js); only the
  // key is kept here, and the file follows the same retention rules.
  cvKey         String               @default("") @db.VarChar(255)
  cvFileName    String               @default("") @db.VarChar(190)
  cvUploadedAt  DateTime?
  // The student's education as it was when they applied for a free internship
  // ({ college, course, department, semester, passingYear }), so a later
  // profile change doesn't rewrite what the application was made with.
  education     Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  payments Payment[]
  attempt  TestAttempt?

  @@index([userId])
  @@index([openingId, status])
  @@map("job_applications")
}

enum AttemptStatus {
  in_progress
  submitted
}

// The one sitting of the test an application's payment buys. The paper (the
// questions drawn for this candidate, options already shuffled, with the right
// answer) is fixed here at start, and the clock is startedAt/endsAt — both
// server-side, so a refresh shows the same paper and can't add time.
model TestAttempt {
  id             String         @id @default(cuid())
  applicationId  String         @unique
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId         String
  status         AttemptStatus  @default(in_progress)
  startedAt      DateTime
  endsAt         DateTime
  submittedAt    DateTime?
  // "manual" | "time_up" | "violations"
  submitReason   String         @default("")
  // The rules as they were when the test started.
  settings       Json
  // [{ qid, category, text, options: [...], correct }] — `correct` is the index
  // into the shuffled options and is stripped before anything goes to the browser.
  paper          Json
  score          Float?
  maxScore       Float?
  correctCount   Int?
  wrongCount     Int?
  categoryScores Json?
  passed         Boolean?
  violationCount Int            @default(0)
  // The one browser session allowed to drive this attempt, and when it last called in.
  sessionId      String?
  sessionSeenAt  DateTime?
  webcamConsent  Boolean        @default(false)
  ip             String         @default("")
  userAgent      String         @default("") @db.VarChar(500)
  device         String         @default("")
  browser        String         @default("")
  viaDesktopApp  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  answers    TestAnswer[]
  violations TestViolation[]
  snapshots  TestSnapshot[]

  @@index([status, endsAt])
  @@map("test_attempts")
}

// One row per question the candidate has touched, saved the moment they answer.
// `selected` is an index into that paper question's shuffled options, or null.
model TestAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  selected   Int?
  marked     Boolean     @default(false)
  updatedAt  DateTime    @updatedAt

  @@unique([attemptId, questionId])
  @@map("test_answers")
}

model TestViolation {
  id        String      @id @default(cuid())
  attemptId String
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String      @db.VarChar(40)
  detail    String      @default("")
  // Whether it counts toward the limit that auto-submits the test. Minor ones
  // (a blocked copy or right-click) and repeats of one incident are logged only.
  counted   Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@index([attemptId, createdAt])
  @@map("test_violations")
}

// A webcam photo taken during the test. Only where the file lives is stored
// here (utils/proctorStorage.js keeps the image itself).
model TestSnapshot {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  storageKey String      @db.VarChar(300)
  // "" | "no_face" | "multiple_faces" (from the browser's face detector, when it has one)
  flag       String      @default("") @db.VarChar(20)
  createdAt  DateTime    @default(now())

  @@index([attemptId, createdAt])
  @@map("test_snapshots")
}

// A message on the student's dashboard (application status changes, credit added).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// One row per deleted account: the proof that an erasure request (DPDP Act
// 2023, s.12) was carried out, and by whom. Holds no personal data: the old
// account id and a keyed hash of its email (so a later "did you delete my
// data?" can be answered without keeping the address itself).
model AccountDeletion {
  id            String   @id @default(cuid())
  formerUserId  String
  emailHash     String   @db.VarChar(64)
  // "self" (the student, from their profile) | "admin" (Admin → Users)
  requestedBy   String   @db.VarChar(10)
  adminId       String?
  // What was kept, and why (e.g. payment records under tax law).
  retainedNote  String   @default("") @db.VarChar(500)
  deletedAt     DateTime @default(now())

  @@index([emailHash])
  @@map("account_deletions")
}
