// Prisma schema for the Crix Technology backend (migrated from MongoDB/Mongoose).
//
// Every model uses a cuid() string primary key — not an auto-increment int —
// specifically so `id` keeps behaving like Mongo's opaque ObjectId string
// end-to-end (the API serializer re-exposes it as `_id`; the Frontend does
// `_id === _id` comparisons and stores ids in component state/`<select>`
// values, so a numeric id could silently break those via type mismatch).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  student
}

model User {
  id                       String    @id @default(cuid())
  name                     String
  email                    String    @unique
  phone                    String    @default("")
  passwordHash             String?
  googleId                 String?   @unique
  role                     Role      @default(student)
  activeSessionId          String?
  activeSessionLastSeenAt  DateTime?
  // Shown to the student in "Refer & earn"; friends enter it at signup/checkout.
  // Created lazily (utils/referrals.js ensureReferralCode) and stored without
  // punctuation, e.g. CRIXK7P3QZ.
  referralCode             String?   @unique
  // The auto-generated starter password given to an account that signed up /
  // signed in with Google (so it also has a working email+password login),
  // AES-256-GCM encrypted (utils/passwordVault.js) so the owner can look it up
  // in their profile after an emailed OTP. Only ever holds a SYSTEM-generated
  // password: cleared the moment the user picks their own (change or reset),
  // and never written for a password the user chose — those exist only as the
  // bcrypt `passwordHash` and can't be shown to anyone.
  defaultPasswordEnc       String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  enrollments  Enrollment[]
  applications Application[]
  payments     Payment[]

  referralsMade Referral[]    @relation("Referrer")
  referredBy    Referral?     @relation("Referee")
  creditEntries CreditEntry[]
  ambassador    Ambassador?
  emailOtps     EmailOtp[]
  paymentRequests PaymentRequest[]

  @@map("users")
}

enum Tier {
  basic
  plus
  pro
}

enum CourseType {
  course
  internship
}

enum CourseStatus {
  open
  closed
}

// One-time email codes for the password flows (forgot password, and revealing
// the starter password in the profile). At most one live code per user per
// purpose — issuing a new one replaces the old. Only an HMAC of the code is
// stored, never the code itself, and a row is deleted as soon as it's used.
model EmailOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String   // "reset_password" | "view_password"
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, purpose])
  @@map("email_otps")
}

model Course {
  id              String       @id @default(cuid())
  type            CourseType   @default(course)
  title           String
  slug            String       @unique
  tag             String       @default("")
  // MySQL forbids a DEFAULT on TEXT columns — the app always passes `desc ||
  // ""` on create (routes/courses.js), so no DB-level default is needed.
  desc            String       @db.Text
  points          Json         @default("[]")
  // The richer course page (see Frontend CourseDetail). All optional lists the admin fills
  // in per course; an empty one simply isn't shown on the page.
  //   outcomes:      "What you'll learn" — short bullets
  //   audience:      "Who it's for" — short bullets
  //   prerequisites: "What you need before you start" — short bullets
  //   faqs:          [{ q, a }] — questions and answers
  outcomes        Json         @default("[]")
  audience        Json         @default("[]")
  prerequisites   Json         @default("[]")
  faqs            Json         @default("[]")
  durationDays    Int?
  status          CourseStatus @default(open)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tiers        CourseTier[]
  lectures     Lecture[]
  videos       Video[]
  enrollments  Enrollment[]
  applications Application[]
  payments     Payment[]
  paymentRequests PaymentRequest[]

  @@map("courses")
}

// One row per plan (basic / plus / pro) a course or internship offers. A tier
// row existing IS the tier being offered — an item with zero rows is
// apply-only / not purchasable. Replaces the old single Course.price and
// Course.discountPercent columns (migration 20260919_course_tiers copies each
// old price into a Basic row). `features` is an admin-written list of what
// that plan includes; it is descriptive only — course access is not gated by tier.
model CourseTier {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tier            Tier
  price           Float
  discountPercent Int      @default(0)
  features        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([courseId, tier])
  @@map("course_tiers")
}

model Lecture {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  title           String
  scheduledAt     DateTime
  scheduledEndAt  DateTime
  link            String
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courseId, scheduledAt])
  @@map("lectures")
}

model Video {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  title             String
  b2Key             String   @unique
  sourceDriveFileId String?
  dayNumber         Int
  durationSeconds   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([courseId, dayNumber])
  @@map("videos")
}

enum EnrollmentStatus {
  active
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  paymentId String?
  payment   Payment?         @relation(fields: [paymentId], references: [id])
  tier      Tier?
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    EnrollmentStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum ApplicationType {
  internship
  course
}

model Application {
  id        String          @id @default(cuid())
  type      ApplicationType
  refTitle  String
  name      String
  email     String
  phone     String
  college   String          @default("")
  track     String          @default("")
  tier      Tier?
  paymentId String?
  payment   Payment?        @relation("ApplicationCurrentPayment", fields: [paymentId], references: [id])
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  courseId  String?
  course    Course?         @relation(fields: [courseId], references: [id])
  contacted Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  paymentsFor Payment[] @relation("PaymentApplication")

  @@map("applications")
}

// An offer/discount code the admin creates in the admin panel and a student
// enters at checkout (courses and internships). See utils/coupons.js for how a
// code is checked and priced.
enum DiscountType {
  percent
  fixed
}

enum CouponScope {
  all
  course
  internship
  selected
}

model Coupon {
  id            String       @id @default(cuid())
  // Stored normalised (A-Z 0-9 only, upper case): people type these in any case
  // and with or without dashes.
  code          String       @unique
  description   String       @default("")
  discountType  DiscountType
  // Percent (1-90), or whole rupees off, depending on discountType.
  discountValue Int
  // For a percent code: never take off more than this many rupees.
  maxDiscount   Int?
  appliesTo     CouponScope  @default(all)
  // Only used when appliesTo is "selected": the ids of the courses/internships.
  courseIds     Json         @default("[]")
  startsAt      DateTime?
  expiresAt     DateTime?
  // Total redemptions allowed across everyone; null = unlimited.
  maxUses       Int?
  // How many times one student may redeem it.
  perUserLimit  Int          @default(1)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  payments Payment[]

  @@map("coupons")
}

enum PaymentStatus {
  created
  paid
  failed
}

model Payment {
  id                            String        @id @default(cuid())
  razorpayOrderId               String
  razorpayPaymentId             String?
  razorpaySignature             String?
  amount                        Int
  currency                      String        @default("INR")
  // Paise taken off this order by a referral discount / by referral credit the
  // buyer had earned. `amount` is already net of both.
  referralDiscount              Int           @default(0)
  creditApplied                 Int           @default(0)
  // The admin-created offer code (see Coupon) this order used, and the paise it
  // took off. `couponCode` is a snapshot, so the history survives the code being
  // edited or deleted. `amount` is already net of it.
  couponId                      String?
  coupon                        Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode                    String        @default("")
  couponDiscount                Int           @default(0)
  tier                          Tier?
  // Set only on a plan-upgrade payment: the plan the buyer held before
  // paying the difference to reach `tier`. Null for an ordinary purchase.
  fromTier                      Tier?
  status                        PaymentStatus @default(created)
  applicationId                 String?
  application                   Application?  @relation("PaymentApplication", fields: [applicationId], references: [id])
  userId                        String?
  user                          User?         @relation(fields: [userId], references: [id])
  courseId                      String?
  course                        Course?       @relation(fields: [courseId], references: [id])
  orderSnapshotBasePrice        Float?
  orderSnapshotDiscountPercent  Float?
  // --- flattened `receipt` subdocument (see the model comment in the old
  // Mongoose Payment.js) — reassembled into a nested `receipt: {...}` object
  // by src/utils/serialize.js so the API response shape is unchanged. ---
  receiptNumber                 String?       @unique
  receiptIssuedAt               DateTime?
  receiptBuyerName              String        @default("")
  receiptBuyerEmail             String        @default("")
  receiptBuyerPhone             String        @default("")
  receiptItemType                String?
  receiptItemTitle              String        @default("")
  receiptBasePrice              Float         @default(0)
  receiptDiscountPercent        Float         @default(0)
  receiptDiscountAmount         Float         @default(0)
  receiptTotalPaid              Float         @default(0)
  receiptPaymentMode            String        @default("Razorpay (Online)")
  // Set only on a payment made against an admin's PaymentRequest (see that
  // model) — such a payment has no Application, and is ordered, verified and
  // granted by routes/paymentRequests.js instead of the normal checkout.
  paymentRequestId              String?
  paymentRequest                PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  applicationsUsingThis Application[] @relation("ApplicationCurrentPayment")
  enrollments           Enrollment[]

  @@map("payments")
}

enum PaymentRequestStatus {
  pending
  paid
  cancelled
}

// An admin asking one specific student to pay a set amount for one course or
// internship. Separate from the normal checkout (no plan pricing, offer codes,
// referral discounts or credit, and it works whether the course is open or
// closed): the student sees it on their dashboard, pays it, and gets access.
// Each pay attempt is its own Payment row (paymentRequestId) so the paid one
// carries a normal receipt; paidPaymentId points at that one.
model PaymentRequest {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The plan the access counts as, if any — descriptive, like everywhere else.
  tier          Tier?
  // Paise.
  amount        Int
  note          String               @default("")
  status        PaymentRequestStatus @default(pending)
  paidPaymentId String?
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  payments Payment[]

  @@index([userId, status])
  @@map("payment_requests")
}

enum ContactStatus {
  new
  read
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String        @default("")
  phone     String        @default("")
  company   String        @default("")
  interest  String        @default("")
  // MySQL forbids a DEFAULT on TEXT columns — the app always passes
  // `message || ""` on create (routes/contact.js), so no DB-level default.
  message   String        @db.Text
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contacts")
}

enum ServiceStatus {
  active
  inactive
}

model Service {
  id        String        @id @default(cuid())
  tag       String        @default("")
  title     String
  // MySQL forbids a DEFAULT on TEXT columns — the app always passes
  // `desc || ""` on create (routes/services.js), so no DB-level default.
  desc      String        @db.Text
  points    Json          @default("[]")
  order     Int           @default(0)
  status    ServiceStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("services")
}

// Generic atomic named counter (one row per sequence) — used to mint
// gap-free, race-safe sequential receipt numbers. See utils/counter.js's
// nextSequence(), which does the atomic increment via a single `UPDATE
// counters SET seq = seq + 1 ...` (Prisma's `{ increment: 1 }`).
model Counter {
  name String @id
  seq  Int    @default(0)

  @@map("counters")
}

enum ReferralStatus {
  pending
  rewarded
}

// One row per referred student (refereeId is unique — a student can only ever
// be referred once). Created when a code is applied; flips to rewarded, and the
// referrer is credited, when the referee's first course/internship payment lands.
// The discount % and reward are snapshotted at apply time so later changes to
// the admin settings never change what was promised.
model Referral {
  id                     String         @id @default(cuid())
  referrerId             String
  referrer               User           @relation("Referrer", fields: [referrerId], references: [id])
  refereeId              String         @unique
  referee                User           @relation("Referee", fields: [refereeId], references: [id])
  status                 ReferralStatus @default(pending)
  refereeDiscountPercent Int            @default(0)
  // Paise credited to the referrer when this is rewarded.
  rewardAmount           Int            @default(0)
  qualifyingPaymentId    String?
  // Set when the referrer was an approved campus ambassador at the time the code
  // was applied: the reward is then a cash commission (commissionPercent of what
  // the friend pays) instead of credit, and rewardAmount stays 0.
  ambassadorId           String?
  ambassador             Ambassador?    @relation(fields: [ambassadorId], references: [id])
  commissionPercent      Int            @default(0)
  createdAt              DateTime       @default(now())
  rewardedAt             DateTime?

  creditEntries CreditEntry[]
  earning       AmbassadorEarning?

  @@index([referrerId])
  @@map("referrals")
}

enum CreditKind {
  referral_reward
  redeemed
  adjustment
}

// Append-only ledger of a student's referral credit, in paise: + earned, - spent.
// Balance is the sum, so there is no counter to race on. The unique pairs make
// "reward this referral" and "redeem for this payment" idempotent when /verify
// and the Razorpay webhook both fire.
model CreditEntry {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  amount     Int
  kind       CreditKind
  referralId String?
  referral   Referral?  @relation(fields: [referralId], references: [id])
  paymentId  String?
  note       String     @default("")
  createdAt  DateTime   @default(now())

  @@unique([paymentId, kind])
  @@unique([referralId, kind])
  @@index([userId])
  @@map("credit_entries")
}

// Small key/value store for admin-editable settings (currently the referral rules).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum AmbassadorStatus {
  applied
  approved
  rejected
  suspended
}

enum KitStatus {
  not_sent
  preparing
  shipped
  delivered
}

enum PayoutStatus {
  requested
  paid
  rejected
}

// A student who applied to be (or is) a campus ambassador. Approved ambassadors
// share their referral code (User.referralCode); friends who use it get the usual
// welcome discount and the ambassador earns a cash commission on what they pay.
model Ambassador {
  id                  String           @id @default(cuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id])
  status              AmbassadorStatus @default(applied)
  college             String
  city                String
  yearOfStudy         String           @default("")
  branch              String           @default("")
  socialHandle        String           @default("")
  // TEXT columns can't have a database default — the app always passes a value.
  motivation          String           @db.Text
  // Overrides the programme-wide commission %; null means use the default.
  commissionPercent   Int?
  // Where to pay — UPI or a bank account. Only the admin paying them ever sees
  // the full details; the ambassador sees the bank account masked.
  upiId               String           @default("")
  bankHolder          String           @default("")
  bankAccount         String           @default("")
  bankIfsc            String           @default("")
  // Perks: a welcome kit (needs somewhere to send it) and a certificate.
  shippingAddress     String           @db.Text
  kitStatus           KitStatus        @default(not_sent)
  kitNote             String           @default("")
  certificateNumber   String?          @unique
  certificateIssuedAt DateTime?
  adminNote           String           @default("")
  appliedAt           DateTime         @default(now())
  approvedAt          DateTime?
  updatedAt           DateTime         @updatedAt

  earnings  AmbassadorEarning[]
  payouts   AmbassadorPayout[]
  referrals Referral[]

  @@map("ambassadors")
}

// One commission, earned when a referred student's first purchase went through
// (referralId is unique, so it can only ever be earned once). It sits on hold
// until availableAt, then becomes payable; a payout request claims it (payoutId).
model AmbassadorEarning {
  id           String            @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador        @relation(fields: [ambassadorId], references: [id])
  referralId   String            @unique
  referral     Referral          @relation(fields: [referralId], references: [id])
  paymentId    String
  // Paise: what the student paid, the % applied, and the resulting commission.
  baseAmount   Int
  percent      Int
  amount       Int
  availableAt  DateTime
  void         Boolean           @default(false)
  payoutId     String?
  payout       AmbassadorPayout? @relation(fields: [payoutId], references: [id])
  createdAt    DateTime          @default(now())

  @@index([ambassadorId])
  @@map("ambassador_earnings")
}

// A request to be paid, and (once the admin has paid it by UPI/bank transfer) the record of it.
model AmbassadorPayout {
  id           String              @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador          @relation(fields: [ambassadorId], references: [id])
  // Paise.
  amount       Int
  status       PayoutStatus        @default(requested)
  // Snapshot of where to send it, taken at request time.
  payTo        String
  reference    String              @default("")
  note         String              @default("")
  requestedAt  DateTime            @default(now())
  paidAt       DateTime?
  updatedAt    DateTime            @updatedAt
  earnings     AmbassadorEarning[]

  @@index([ambassadorId])
  @@map("ambassador_payouts")
}
