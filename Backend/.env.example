# ============================================================
# Copy this file to .env and fill in real values.
# TEST MODE FOR NOW: use Razorpay's TEST keys (rzp_test_...).
# Jab live jaana ho, sirf yeh teen Razorpay lines badlo (live
# keys se) — code mein kahin kuch change nahi karna padega.
# ============================================================

PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MySQL connection string (local dev: mysql://root:<password>@localhost:3306/crix).
DATABASE_URL=mysql://root:password@localhost:3306/crix

# Admin login (first run par seed:admin script isse Admin bana dega)
ADMIN_EMAIL=admin@crixtechnology.com
ADMIN_PASSWORD=change_this_password
JWT_SECRET=change_this_to_a_long_random_string

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application. Same value goes
# in Frontend/.env as REACT_APP_GOOGLE_CLIENT_ID. Leave blank to disable
# the "Continue with Google" button (email/password still works).
GOOGLE_CLIENT_ID=

# Razorpay — abhi TEST keys (razorpay.com dashboard > Test Mode > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Dashboard > Webhooks > naya webhook banate waqt jo secret milega
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---------- Drip recorded-video delivery (see VIDEO_SYSTEM.md) ----------
# Public origin of the Cloudflare Worker video gateway (custom domain or the
# *.workers.dev URL). No trailing slash.
VIDEO_GATEWAY_URL=https://videos.crixtechnology.com
# Shared HMAC secret — MUST be byte-identical to the Worker's SIGNING_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=change_this_to_a_long_random_string
# Static bearer token the drive-to-b2-sync script uses to call
# POST /api/internal/videos. Same value in scripts/drive-to-b2-sync/.env.
COURSE_API_INTERNAL_TOKEN=change_this_to_a_long_random_string

# Contact form email — sent via formsubmit.co's AJAX endpoint (see
# utils/mailer.js), which needs no API key or sender verification, just
# this inbox. Two things tried before landing here: raw SMTP (Gmail, then
# Brevo's own SMTP relay) hung on every attempt because this backend's
# Render plan silently drops outbound TCP on non-HTTP(S) ports; Brevo's own
# HTTP API connected fine but its sender — a plain @gmail.com address, not
# a domain Brevo can add DKIM/DMARC records for — got flagged by Google/
# Yahoo/Microsoft's sender-authentication rules and never actually arrived.
#
# One-time setup: the first real submission after this is set makes
# formsubmit.co send *this inbox* a confirmation link — it must be clicked
# before formsubmit.co will forward that submission or any future one.
CONTACT_TO_EMAIL=support@crixtechnology.com

# Receipt email (sent to the CUSTOMER after a paid purchase, with the PDF
# receipt attached — see utils/mailer.js's sendReceiptEmail). formsubmit.co
# above can't be reused for this: it requires the RECEIVING address to click
# a one-time confirmation link first, which works for your own inbox but not
# for a different customer's inbox every time. Uses Resend's HTTP API
# instead (resend.com — free tier is plenty for this volume).
#   1. Create a Resend account, add crixtechnology.in as a sending domain,
#      add the SPF/DKIM DNS records Resend gives you (this is what avoids
#      the spam-flagging the earlier bare-gmail.com Brevo sender hit).
#   2. Dashboard > API Keys > create one, paste it below.
# Leave RESEND_API_KEY blank to skip receipt emails entirely — the in-app
# "Download Receipt" button on /dashboard still works either way.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Crix Technology <receipts@crixtechnology.in>
