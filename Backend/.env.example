# ============================================================
# Copy this file to .env and fill in real values.
# TEST MODE FOR NOW: use Razorpay's TEST keys (rzp_test_...).
# Jab live jaana ho, sirf yeh teen Razorpay lines badlo (live
# keys se) — code mein kahin kuch change nahi karna padega.
# ============================================================
#
# BEFORE GOING LIVE — checklist for the real server:
#   1. NODE_ENV=production, and a fresh random JWT_SECRET (48+ random bytes;
#      the server refuses to start in production with the example value).
#   2. Email: BREVO_API_KEY (or SMTP_*). Without it no receipts, password
#      codes or signup-bonus codes go out — new email/password accounts can't
#      verify their email, so they never receive their signup bonus.
#   3. CLIENT_ORIGIN = public site(s) + the admin panel; ADMIN_ORIGIN = admin URL.
#   4. PROCTOR_* bucket for aptitude-test webcam photos (a host whose disk is
#      wiped on each deploy, like Render's free tier, loses local photos).
#   5. Razorpay live keys + RAZORPAY_WEBHOOK_SECRET, then ALLOW_LIVE_PAYMENTS=true.
#   6. After deploying: npx prisma migrate deploy, then npm run seed:careers
#      (or add roles in Admin → Job openings) so the Careers page has real roles.
# ============================================================

PORT=5000
# Comma-separated list of every frontend allowed to call this API: the public
# site AND the separately deployed admin panel (its Vercel URL), e.g.
#   CLIENT_ORIGIN=https://www.crixtechnology.com,https://www.crixtechnology.in,https://crix-admin.vercel.app
# The FIRST entry is treated as the public site's own address (.com is the main domain;
# .in is listed too while it still serves the site).
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001
# Where the admin panel lives — used for the "open messages/applications" links in
# notification emails. No trailing slash.
ADMIN_ORIGIN=http://localhost:3001

# MySQL-compatible connection string.
#   Local dev: mysql://root:<password>@localhost:3306/crix
#   TiDB Cloud (production): copy the connection string from the TiDB dashboard;
#   it needs TLS, so keep the SSL option on the end, e.g.
#   mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
# Apply migrations with `prisma migrate deploy` (what render-build runs); avoid
# `prisma migrate dev` against TiDB — it needs a second scratch database.
# Tests derive a `<name>_test` database from this URL, so use an account that
# can create databases locally.
DATABASE_URL=mysql://root:password@localhost:3306/crix

# Admin login (first run par seed:admin script isse Admin bana dega)
ADMIN_EMAIL=admin@crixtechnology.com
ADMIN_PASSWORD=change_this_password
# Signs every login token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application. Same value goes
# in Frontend/.env as REACT_APP_GOOGLE_CLIENT_ID. Leave blank to disable
# the "Continue with Google" button (email/password still works).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Razorpay — abhi TEST keys (razorpay.com dashboard > Test Mode > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Dashboard > Webhooks > naya webhook banate waqt jo secret milega
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
# Safety guard: with a LIVE key (rzp_live_...) order creation is refused (503)
# unless this is exactly "true". Set it only on the production server, once
# live keys and the webhook secret are in place. Test keys ignore it.
ALLOW_LIVE_PAYMENTS=false
# Base URL that src/scripts/testWebhook.js sends its signed test webhook to.
# Only used by that dev script; defaults to http://localhost:5000.
SELF_URL=http://localhost:5000

# ---------- Drip recorded-video delivery (see VIDEO_SYSTEM.md) ----------
# Public origin of the Cloudflare Worker video gateway (custom domain or the
# *.workers.dev URL). No trailing slash.
VIDEO_GATEWAY_URL=https://videos.crixtechnology.com
# Shared HMAC secret — MUST be byte-identical to the Worker's SIGNING_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=change_this_to_a_long_random_string
# Static bearer token the drive-to-b2-sync script uses to call
# POST /api/internal/videos. Same value in scripts/drive-to-b2-sync/.env.
COURSE_API_INTERNAL_TOKEN=change_this_to_a_long_random_string
# Backblaze access for the admin "Delete file too" button on /admin/videos, which
# permanently deletes a video's file (all versions) from the private bucket.
# Optional: leave these blank and "Remove from site" still works, while "Delete
# file too" answers that the server isn't connected to Backblaze (and changes
# nothing). Create a DEDICATED application key restricted to the lecture bucket
# with only the listFiles + deleteFiles capabilities — not the master key and
# not the sync's key. Same bucket/endpoint values as scripts/drive-to-b2-sync.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# Contact form email — sent via formsubmit.co's AJAX endpoint (see
# utils/mailer.js), which needs no API key or sender verification, just
# this inbox. Two things tried before landing here: raw SMTP (Gmail, then
# Brevo's own SMTP relay) hung on every attempt because this backend's
# Render plan silently drops outbound TCP on non-HTTP(S) ports; Brevo's own
# HTTP API connected fine but its sender — a plain @gmail.com address, not
# a domain Brevo can add DKIM/DMARC records for — got flagged by Google/
# Yahoo/Microsoft's sender-authentication rules and never actually arrived.
#
# One-time setup: the first real submission after this is set makes
# formsubmit.co send *this inbox* a confirmation link — it must be clicked
# before formsubmit.co will forward that submission or any future one.
CONTACT_TO_EMAIL=support@crixtechnology.com

# ---------- Email to the CUSTOMER via Brevo's HTTP API (utils/mailer.js) ----------
# Works on Render's free tier (it's an HTTPS request, not SMTP). When set, every
# customer email below goes through Brevo and the SMTP_* settings are ignored.
# The FROM address must be on a domain AUTHENTICATED in Brevo (Senders, Domains
# & Dedicated IPs → Domains → add the DKIM/DMARC DNS records it shows) and added
# as a sender — a plain @gmail.com sender gets silently dropped by Gmail/Outlook.
# API key: Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
MAIL_FROM=Crix Technology <support@crixtechnology.com>

# ---------- Fallback: email to the CUSTOMER over SMTP (utils/mailer.js) ----------
# Sends: the purchase receipt (PDF attached, course AND internship), the
# forgot-password / view-password one-time codes, "password changed" and
# "you already have an account" notices. formsubmit.co above can't do this: it
# requires the RECEIVING address to click a confirmation link first.
#
# NEEDS A HOST THAT ALLOWS OUTBOUND SMTP (a VPS). Render's free tier blocks
# those ports, so there these sends time out and are only logged — OTP requests
# from the profile page then answer "couldn't send"; receipts and everything
# else keep working (the in-app "Download Receipt" button is unaffected).
#
# Any SMTP provider works (your domain's mailbox, Brevo, Zoho, SES, Gmail with an
# app password...). SMTP_FROM should be an address the provider lets you send
# as, ideally on a domain with SPF/DKIM set up so mail doesn't land in spam.
# e.g. smtp.gmail.com · smtp.zoho.in · smtp-relay.brevo.com · mail.yourdomain.com
# Any value containing "your_" counts as "not set up yet" (nothing is sent; MAIL_DEV_LOG applies).
SMTP_HOST=your_smtp_host
SMTP_PORT=587
# true = implicit TLS (use with port 465); false (or blank) = STARTTLS on 587.
SMTP_SECURE=false
# e.g. no-reply@crixtechnology.in
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Crix Technology <no-reply@crixtechnology.in>

# LOCAL DEVELOPMENT ONLY: with SMTP_HOST empty, print each email (including OTP
# codes) to the server console instead of sending, so the password flows can be
# tried without SMTP. Never enable on a real server — it logs one-time codes.
MAIL_DEV_LOG=

# Key for encrypting Google-account starter passwords (User.defaultPasswordEnc,
# shown to the owner after an emailed OTP). Use a long random string; falls back
# to JWT_SECRET if unset. Changing it makes already-stored starter passwords
# unreadable (the owner can still use Forgot password).
DEFAULT_PASSWORD_KEY=

# ---------- Careers & the aptitude test ----------
# Where the test's webcam snapshots are stored (utils/proctorStorage.js). The
# database only holds each file's key. Leave these blank to keep them on this
# server's disk under Backend/storage/proctoring (fine for local development).
# On a host whose disk is wiped on every deploy (e.g. Render's free tier), use a
# PRIVATE S3-compatible bucket instead, with an application key limited to that
# bucket with "Read and Write" access (it must be able to delete: photos are
# removed after their retention period and when an account is deleted) — never
# the lecture bucket's key. In Backblaze, set the bucket's lifecycle to "Keep
# only the last version of the file", so a deleted photo is really erased and
# not just hidden. The endpoint is written WITHOUT https:// (e.g.
# s3.us-east-005.backblazeb2.com); it and the region default to B2_S3_ENDPOINT /
# B2_REGION above. Check it works with: npm run check:proctor-storage
PROCTOR_BUCKET=
PROCTOR_KEY_ID=
PROCTOR_APP_KEY=
PROCTOR_S3_ENDPOINT=
PROCTOR_REGION=
# Optional: a different local folder for snapshots when no bucket is set.
PROCTOR_LOCAL_DIR=
# Shared secret for the future desktop lockdown app (utils/careers.js
# verifyDesktopAppToken). Only needed once that app exists and "Only allow the
# test in the desktop app" is switched on in Admin > Careers settings.
LOCKDOWN_APP_SECRET=
