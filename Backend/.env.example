# ============================================================
# Copy this file to .env and fill in real values.
# TEST MODE FOR NOW: use Razorpay's TEST keys (rzp_test_...).
# Jab live jaana ho, sirf yeh teen Razorpay lines badlo (live
# keys se) — code mein kahin kuch change nahi karna padega.
# ============================================================

PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MySQL connection string (local dev: mysql://root:<password>@localhost:3306/crix).
DATABASE_URL=mysql://root:password@localhost:3306/crix

# Admin login (first run par seed:admin script isse Admin bana dega)
ADMIN_EMAIL=admin@crixtechnology.com
ADMIN_PASSWORD=change_this_password
JWT_SECRET=change_this_to_a_long_random_string

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application. Same value goes
# in Frontend/.env as REACT_APP_GOOGLE_CLIENT_ID. Leave blank to disable
# the "Continue with Google" button (email/password still works).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Razorpay — abhi TEST keys (razorpay.com dashboard > Test Mode > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Dashboard > Webhooks > naya webhook banate waqt jo secret milega
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---------- Drip recorded-video delivery (see VIDEO_SYSTEM.md) ----------
# Public origin of the Cloudflare Worker video gateway (custom domain or the
# *.workers.dev URL). No trailing slash.
VIDEO_GATEWAY_URL=https://videos.crixtechnology.com
# Shared HMAC secret — MUST be byte-identical to the Worker's SIGNING_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=change_this_to_a_long_random_string
# Static bearer token the drive-to-b2-sync script uses to call
# POST /api/internal/videos. Same value in scripts/drive-to-b2-sync/.env.
COURSE_API_INTERNAL_TOKEN=change_this_to_a_long_random_string
# Backblaze access for the admin "Delete file too" button on /admin/videos, which
# permanently deletes a video's file (all versions) from the private bucket.
# Optional: leave these blank and "Remove from site" still works, while "Delete
# file too" answers that the server isn't connected to Backblaze (and changes
# nothing). Create a DEDICATED application key restricted to the lecture bucket
# with only the listFiles + deleteFiles capabilities — not the master key and
# not the sync's key. Same bucket/endpoint values as scripts/drive-to-b2-sync.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# Contact form email — sent via formsubmit.co's AJAX endpoint (see
# utils/mailer.js), which needs no API key or sender verification, just
# this inbox. Two things tried before landing here: raw SMTP (Gmail, then
# Brevo's own SMTP relay) hung on every attempt because this backend's
# Render plan silently drops outbound TCP on non-HTTP(S) ports; Brevo's own
# HTTP API connected fine but its sender — a plain @gmail.com address, not
# a domain Brevo can add DKIM/DMARC records for — got flagged by Google/
# Yahoo/Microsoft's sender-authentication rules and never actually arrived.
#
# One-time setup: the first real submission after this is set makes
# formsubmit.co send *this inbox* a confirmation link — it must be clicked
# before formsubmit.co will forward that submission or any future one.
CONTACT_TO_EMAIL=support@crixtechnology.com

# ---------- Email to the CUSTOMER, over SMTP (utils/mailer.js) ----------
# Sends: the purchase receipt (PDF attached, course AND internship), the
# forgot-password / view-password one-time codes, "password changed" and
# "you already have an account" notices. formsubmit.co above can't do this: it
# requires the RECEIVING address to click a confirmation link first.
#
# NEEDS A HOST THAT ALLOWS OUTBOUND SMTP (a VPS). Render's free tier blocks
# those ports, so there these sends time out and are only logged — OTP requests
# from the profile page then answer "couldn't send"; receipts and everything
# else keep working (the in-app "Download Receipt" button is unaffected).
#
# Any SMTP provider works (your domain's mailbox, Brevo, Zoho, SES, Gmail with an
# app password...). SMTP_FROM should be an address the provider lets you send
# as, ideally on a domain with SPF/DKIM set up so mail doesn't land in spam.
# e.g. smtp.gmail.com · smtp.zoho.in · smtp-relay.brevo.com · mail.yourdomain.com
# Any value containing "your_" counts as "not set up yet" (nothing is sent; MAIL_DEV_LOG applies).
SMTP_HOST=your_smtp_host
SMTP_PORT=587
# true = implicit TLS (use with port 465); false (or blank) = STARTTLS on 587.
SMTP_SECURE=false
# e.g. no-reply@crixtechnology.in
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Crix Technology <no-reply@crixtechnology.in>

# LOCAL DEVELOPMENT ONLY: with SMTP_HOST empty, print each email (including OTP
# codes) to the server console instead of sending, so the password flows can be
# tried without SMTP. Never enable on a real server — it logs one-time codes.
MAIL_DEV_LOG=

# Key for encrypting Google-account starter passwords (User.defaultPasswordEnc,
# shown to the owner after an emailed OTP). Use a long random string; falls back
# to JWT_SECRET if unset. Changing it makes already-stored starter passwords
# unreadable (the owner can still use Forgot password).
DEFAULT_PASSWORD_KEY=
