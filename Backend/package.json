  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "reset:admin-password": "node src/scripts/resetAdminPassword.js",
    "seed:programs": "node src/scripts/seedPrograms.js",
