# Copy to .env and fill in. Gitignored.

# --- for upload-test-video.js ---
B2_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=crix-course-videos
B2_KEY_ID=your_b2_application_key_id
B2_APP_KEY=your_b2_application_key

# --- for generate-signed-link.js ---
# Must match the Worker's SIGNING_SECRET (and Backend/.env SIGNING_SECRET).
SIGNING_SECRET=change_this_to_a_long_random_string
# Where the Worker is reachable. Local wrangler dev default is below;
# set to your deployed origin (https://videos.crixtechnology.com) to test prod.
VIDEO_GATEWAY_URL=http://localhost:8787
