# Copy to .env and fill in. This file (and .env, and .sync-state.json) are
# gitignored.
#
# Onboarding a new course whose recordings land in the SAME shared Drive
# folder as an existing one (courses launch on a rolling basis, so this
# happens whenever the next course's batch actually starts and its own
# Google Meet series exists): don't overwrite the existing .env — copy this
# file to a new name instead, e.g. .env.ai-agentic, and fill in that
# course's own COURSE_ID + a FILE_NAME_INCLUDES matching its Meet nickname
# (each course has its own distinct Meet link/nickname, so the auto-named
# recordings are already distinguishable by name). Run it with:
#   node index.js --env-file=.env.ai-agentic --loop
# IMPORTANT: at that point, also go back and give every OTHER course's own
# .env a real FILE_NAME_INCLUDES if it's still blank — a blank filter
# matches every file in the folder, which means an existing course's sync
# would start silently swallowing the new course's recordings too.

# ---------- Google Drive (source) ----------
# The folder Google Meet drops recordings into. From the folder URL:
#   https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=
# Only if that folder lives inside a Shared Drive — the Shared Drive's id.
SHARED_DRIVE_ID=
# Service account with the readonly Drive scope. Either a path to the key
# JSON file...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# ...or paste the whole JSON on one line instead (leave the file var blank):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}

# ---------- Backblaze B2 (destination, S3-compatible) ----------
B2_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=crix-course-videos
B2_KEY_ID=your_b2_application_key_id
B2_APP_KEY=your_b2_application_key
# Optional prefix for every object key, e.g. "web-dev/". Keep it if one
# bucket holds videos for several courses.
B2_KEY_PREFIX=

# ---------- Course API (registration) ----------
COURSE_API_URL=http://localhost:5000
COURSE_API_INTERNAL_TOKEN=change_this_to_a_long_random_string
# Mongo _id of the Course these recordings belong to (from /admin or the DB).
COURSE_ID=
# One Meet folder often holds several courses' recordings. Keep only files
# whose name contains this (comma-separated, case-insensitive); blank = all.
FILE_NAME_INCLUDES=
# ...and drop any whose name contains this. Blank = exclude nothing.
FILE_NAME_EXCLUDES=

# ---------- Behaviour ----------
STATE_FILE=./.sync-state.json
POLL_INTERVAL_SECONDS=300
UPLOAD_PART_SIZE_MB=16
